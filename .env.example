# ─── App ────────────────────────────────────────────────────────────────────
PORT=3000

# ─── Booking V2 client (production cutover) ─────────────────────────────────
# Enable Booking V2 O2 client (/book). Required true for production cutover.
NEXT_PUBLIC_BOOKING_V2_CLIENT=true

# Single booking API base (preferred). Production MUST be HTTPS, never localhost.
# PRODUCTION_BOOKING_API_BASE_URL = https://casher-five.vercel.app
NEXT_PUBLIC_BOOKING_API_BASE_URL=https://casher-five.vercel.app
NEXT_PUBLIC_API_BASE_URL=https://casher-five.vercel.app

# Optional alias still used by some non-booking / legacy helpers:
NEXT_PUBLIC_CASHER_API_BASE_URL=https://casher-five.vercel.app

# Local Hawai only (never set these in Vercel Production / Preview):
# NEXT_PUBLIC_BOOKING_API_BASE_URL=http://localhost:5500
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5500

# Optional: disable booking UI entirely (default: enabled)
# NEXT_PUBLIC_BOOKING_ENABLED=false
